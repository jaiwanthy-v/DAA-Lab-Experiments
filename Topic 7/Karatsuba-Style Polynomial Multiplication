def naive_poly(A, B):
    result = [0] * (len(A) + len(B) - 1)

    for i in range(len(A)):
        for j in range(len(B)):
            result[i + j] += A[i] * B[j]

    return result


def karatsuba_poly(A, B):
    # For small polynomials
    if len(A) <= 1 or len(B) <= 1:
        return naive_poly(A, B)

    n = max(len(A), len(B))
    m = n // 2

    A = A + [0] * (n - len(A))
    B = B + [0] * (n - len(B))

    A_low = A[:m]
    A_high = A[m:]

    B_low = B[:m]
    B_high = B[m:]

    z0 = karatsuba_poly(A_low, B_low)
    z2 = karatsuba_poly(A_high, B_high)

    A_sum = [A_low[i] + A_high[i] for i in range(m)]
    B_sum = [B_low[i] + B_high[i] for i in range(m)]

    z1 = karatsuba_poly(A_sum, B_sum)

    z1 = [z1[i] - (z0[i] if i < len(z0) else 0)
          - (z2[i] if i < len(z2) else 0)
          for i in range(len(z1))]

    result = [0] * (2 * n - 1)

    for i in range(len(z0)):
        result[i] += z0[i]

    for i in range(len(z1)):
        result[i + m] += z1[i]

    for i in range(len(z2)):
        result[i + 2*m] += z2[i]

    return result


A = [1, 2]
B = [3, 4]

print("Result:", karatsuba_poly(A, B))
