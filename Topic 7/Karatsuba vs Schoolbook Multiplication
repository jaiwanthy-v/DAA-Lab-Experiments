def schoolbook(x, y):
    return x * y


def karatsuba(x, y):
    if x < 10 or y < 10:
        return x * y

    n = max(len(str(x)), len(str(y)))
    m = n // 2

    high1 = x // 10**m
    low1 = x % 10**m
    high2 = y // 10**m
    low2 = y % 10**m

    z2 = karatsuba(high1, high2)
    z0 = karatsuba(low1, low2)
    z1 = karatsuba(high1 + low1, high2 + low2) - z2 - z0

    return z2 * 10**(2*m) + z1 * 10**m + z0


for digits in [2, 4, 8, 16, 32]:
    x = int('7' * digits)
    y = int('3' * digits)

    print("Digits:", digits)
    print("Schoolbook:", schoolbook(x, y))
    print("Karatsuba:", karatsuba(x, y))
    print()
