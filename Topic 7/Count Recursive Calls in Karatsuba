def karatsuba_count(x, y, counter):
    counter[0] += 1

    if x < 10 or y < 10:
        return x * y

    n = max(len(str(x)), len(str(y)))
    m = n // 2

    high1 = x // 10**m
    low1 = x % 10**m

    high2 = y // 10**m
    low2 = y % 10**m

    z2 = karatsuba_count(high1, high2, counter)
    z0 = karatsuba_count(low1, low2, counter)

    z1 = (karatsuba_count(high1 + low1,
                          high2 + low2,
                          counter)
          - z2 - z0)

    return z2 * 10**(2*m) + z1 * 10**m + z0


counter = [0]

result = karatsuba_count(1234, 5678, counter)

print("Result:", result)
print("Recursive calls:", counter[0])
