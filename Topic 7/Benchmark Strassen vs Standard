import random
import time


def standard_multiply(A, B):
    n = len(A)
    C = [[0] * n for _ in range(n)]

    for i in range(n):
        for j in range(n):
            for k in range(n):
                C[i][j] += A[i][k] * B[k][j]

    return C


def strassen_simple(A, B):
    # For benchmarking, use standard multiplication for small matrices
    # and Strassen for larger matrices.
    n = len(A)

    if n <= 2:
        return standard_multiply(A, B)

    # Use the Strassen program from Program 1 here.
    return standard_multiply(A, B)


def random_matrix(n):
    return [[random.randint(1, 10) for _ in range(n)] for _ in range(n)]


n = 16

A = random_matrix(n)
B = random_matrix(n)

start = time.time()
standard_multiply(A, B)
standard_time = time.time() - start

start = time.time()
strassen_simple(A, B)
strassen_time = time.time() - start

print("Standard time:", standard_time)
print("Strassen time:", strassen_time)
