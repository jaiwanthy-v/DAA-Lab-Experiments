def merge_sort(a):
    if len(a) <= 1:
        return a, 0

    mid = len(a) // 2
    left, c1 = merge_sort(a[:mid])
    right, c2 = merge_sort(a[mid:])

    result = []
    i = j = count = 0

    while i < len(left) and j < len(right):
        count += 1
        if left[i] <= right[j]:
            result.append(left[i])
            i += 1
        else:
            result.append(right[j])
            j += 1

    return result + left[i:] + right[j:], c1 + c2 + count

def quick_sort(a, low, high):
    global qcount

    if low < high:
        pivot = a[high]
        i = low - 1

        for j in range(low, high):
            qcount += 1
            if a[j] <= pivot:
                i += 1
                a[i], a[j] = a[j], a[i]

        a[i + 1], a[high] = a[high], a[i + 1]
        p = i + 1

        quick_sort(a, low, p - 1)
        quick_sort(a, p + 1, high)

a = list(map(int, input().split()))

_, merge_count = merge_sort(a.copy())

qcount = 0
quick_sort(a.copy(), 0, len(a) - 1)

print("N:", len(a))
print("Merge Comparisons:", merge_count)
print("Quick Comparisons:", qcount)
