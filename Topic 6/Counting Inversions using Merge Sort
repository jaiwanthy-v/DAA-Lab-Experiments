def merge_sort(a):
    if len(a) <= 1:
        return a, 0

    mid = len(a) // 2
    left, x = merge_sort(a[:mid])
    right, y = merge_sort(a[mid:])

    result = []
    i = j = inv = 0

    while i < len(left) and j < len(right):
        if left[i] <= right[j]:
            result.append(left[i])
            i += 1
        else:
            result.append(right[j])
            inv += len(left) - i
            j += 1

    result += left[i:]
    result += right[j:]

    return result, x + y + inv

a = list(map(int, input().split()))
a, inv = merge_sort(a)

print("Sorted:", *a)
print("Inversions:", inv)
