def orientation(a, b, c):
    value = ((b[1] - a[1]) * (c[0] - b[0]) -
             (b[0] - a[0]) * (c[1] - b[1]))

    if value == 0:
        return 0
    elif value > 0:
        return 1
    return 2


def convex_hull(points):
    hull = []

    for i in range(len(points)):
        for j in range(i + 1, len(points)):
            left = right = False

            for k in range(len(points)):
                if k == i or k == j:
                    continue

                o = orientation(points[i], points[j], points[k])

                if o == 1:
                    left = True
                elif o == 2:
                    right = True

            if not (left and right):
                hull.extend([points[i], points[j]])

    return list(dict.fromkeys(hull))


points = [(1, 1), (2, 4), (5, 5), (6, 2), (3, 0)]

print("Convex Hull Points:")
for p in convex_hull(points):
    print(p)
