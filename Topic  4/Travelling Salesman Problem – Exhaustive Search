from itertools import permutations
import math


def distance(p1, p2):
    return math.sqrt((p1[0] - p2[0]) ** 2 +
                     (p1[1] - p2[1]) ** 2)


def tsp(points):
    start = points[0]
    min_distance = float('inf')
    best_path = None

    for path in permutations(points[1:]):
        route = [start] + list(path) + [start]
        total = 0

        for i in range(len(route) - 1):
            total += distance(route[i], route[i + 1])

        if total < min_distance:
            min_distance = total
            best_path = route

    return min_distance, best_path


test_cases = [
    [(1, 2), (4, 5), (7, 1), (3, 6)],
    [(2, 4), (8, 1), (1, 7), (6, 3), (5, 9)]
]

for i, points in enumerate(test_cases, 1):
    d, path = tsp(points)

    print("Test Case", i)
    print("Shortest Distance:", d)
    print("Shortest Path:", path)
    print()
