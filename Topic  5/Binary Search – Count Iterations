def binary_search(arr, key):
    low = 0
    high = len(arr) - 1
    iterations = 0

    while low <= high:
        iterations += 1
        mid = (low + high) // 2

        if arr[mid] == key:
            print("Element found")
            print("Iterations =", iterations)
            return
        elif arr[mid] < key:
            low = mid + 1
        else:
            high = mid - 1

    print("Element not found")
    print("Iterations =", iterations)


arr = list(map(int, input().split()))
key = int(input())

binary_search(arr, key)
