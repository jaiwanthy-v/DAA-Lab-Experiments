def dice_ways(n, m, target):
    dp = [[0] * (target + 1) for _ in range(n + 1)]
    dp[0][0] = 1

    for i in range(1, n + 1):
        for s in range(1, target + 1):
            for face in range(1, m + 1):
                if s >= face:
                    dp[i][s] += dp[i - 1][s - face]

    return dp[n][target]

print("Number of ways =", dice_ways(3, 4, 7))
